{
  "manifest_version": 3,
  "name": "大健本机连接 · 测试版",
  "version": "0.5.0",
  "description": "按买家和地区核验大健退货率与收藏；支持三十款分组和只读回执恢复。",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
